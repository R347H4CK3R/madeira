+     * session; system32 also supports sessions whose system DLLs are EC. */
+    static const WCHAR bootstrap_path[] = L"C:\\windows\\sysx64;C:\\windows\\system32";
     OBJECT_ATTRIBUTES attr;
     WINE_MODREF *wm;
     NTSTATUS status;
@@ -5335,7 +5341,8 @@
         NtClose( key );
     }
 
-    if ((status = load_dll( NULL, module, 0, &wm, FALSE )))
+    ERR( "[ec-bootstrap] native dependency search=%s\n", debugstr_w(bootstrap_path) );
+    if ((status = load_dll( bootstrap_path, module, 0, &wm, FALSE )))
     {
         ERR( "could not load %s, status %lx\n", debugstr_w(module), status );
         NtTerminateProcess( GetCurrentProcess(), status );
